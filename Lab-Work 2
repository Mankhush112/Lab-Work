<!DOCTYPE html>
<html>
<head>
    <title>Table Layout</title>

    <style>
        table {
            width: 800px;
            height: 400px;
            border-collapse: collapse;
            margin: 50px auto;
        }

        td {
            border: 2px solid black;
        }

        .small {
            width: 20%;
        }

        .medium {
            width: 30%;
        }

        .right {
            width: 50%;
        }
    </style>
</head>

<body>

    <table>
        <tr>
            <td class="small"></td>
            <td class="medium"></td>
            <td class="right"></td>
        </tr>

        <tr>
            <td colspan="2" rowspan="2"></td>

            <td></td>
        </tr>

        <tr>
            <td></td>
        </tr>
    </table>

</body>
</html>
